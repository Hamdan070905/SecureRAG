{
  "name": "securerag-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.383.0",
    "plugins": "^1.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.22.0",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.12.0",
    "remark-gfm": "^4.0.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.securerag.enterprise",
    "productName": "SecureRAG Enterprise",
    "compression": "store",
    "icon": "assets/logo.ico",
    "directories": {
      "output": "dist-electron"
    },
    "protocols": [
      {
        "name": "SecureRAG Enterprise Protocol",
        "schemes": [
          "securerag"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../.venv",
        "to": ".venv",
        "filter": [
          "**/*",
          "!**/__pycache__/*",
          "!**/*.pyc",
          "!**/tests/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico",
      "signExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SecureRAG Enterprise",
      "differentialPackage": false,
      "perMachine": false,
      "guid": "8f3b2a1c-9e8d-7f6a-5b4c-3d2e1f0a9b8c",
      "uninstallDisplayName": "SecureRAG Enterprise",
      "deleteAppDataOnUninstall": true,
      "preCompressedFileExtensions": [
        ".py",
        ".pyc",
        ".pyd",
        ".dll",
        ".exe",
        ".json",
        ".txt",
        ".png",
        ".jpg",
        ".pyi",
        ".h",
        ".c",
        ".zip",
        ".gz",
        ".tar",
        ".pem",
        ".cfg",
        ".dat",
        ".so",
        ".a",
        ".lib"
      ]
    }
  }
}